  "main": "built/app.js",
  "scripts": {
    "dev": "concurrently './node_modules/.bin/http-server ./ -p 80' 'cd ../watch-api && npm run start:develop' 'npm run build:watch'",
    "build": "rm -rf ./built && ./node_modules/.bin/tsc -p tsconfig.json",
    "build:watch": "rm -rf ./built && ./node_modules/.bin/tsc -p tsconfig.json -w",
