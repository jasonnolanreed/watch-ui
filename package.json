  "license": "ISC",
  "dependencies": {
    "chart.js": "3.7.1",
    "chartjs-plugin-annotation": "1.3.1",
    "navigo": "7.1.2"
  },
  "devDependencies": {
    "http-server": "14.1.1",
    "typescript": "5.3.3"
  }
}